          "xml_doc": "",
          "body_summary": "{\r\n        _logger = logger;\r\n        _config = TypeAdapterConfig.GlobalSettings;\r\n        _logger.LogInformation(\"Mapster Adapter Start working\");\r\n    }",
          "attributes": []
        },
        {
          "name": "Map",
          "kind": "method",
          "signature": "public TDestination Map<TDestination>(object source)",
          "xml_doc": "",
          "body_summary": "{\r\n        _logger.LogTrace(\"AutoMapper Adapter Map {source} To {destination} with data {sourcedata}\",\r\n            typeof(object),\r\n            typeof(TDestination),\r\n            source);\r\n        return source.Adapt<TDestination>(_config);\r\n    }",
          "attributes": []
        },

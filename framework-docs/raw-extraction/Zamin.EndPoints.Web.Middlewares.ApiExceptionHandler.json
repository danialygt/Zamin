      "members": [
        {
          "name": ".ctor",
          "kind": "constructor",
          "signature": "public ApiExceptionMiddleware(ApiExceptionOptions options, RequestDelegate next,\r\n            ILogger<ApiExceptionMiddleware> logger, IJsonSerializer serializer,ITranslator translator\r\n            )",
          "xml_doc": "",
          "body_summary": "{\r\n            _next = next;\r\n            _logger = logger;\r\n            _options = options;\r\n            _serializer = serializer;\r\n            _translator = translator;\r\n        }",
          "attributes": []
        },
        {
          "name": "Invoke",
          "kind": "method",
          "signature": "public async Task Invoke(HttpContext context)",
          "xml_doc": "",
          "body_summary": "{\r\n            try\r\n            {\r\n                await _next(context);\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                await HandleExceptionAsync(context, ex);\r\n            }\r\n        }",

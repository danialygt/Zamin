        {
          "name": "GetShadowPropertyValue",
          "kind": "method",
          "signature": "public T GetShadowPropertyValue<T>(object entity, string propertyName) where T : IConvertible",
          "xml_doc": "",
          "body_summary": "{\r\n        var value = Entry(entity).Property(propertyName).CurrentValue;\r\n        return value != null\r\n            ? (T)Convert.ChangeType(value, typeof(T), CultureInfo.InvariantCulture)\r\n            : default;\r\n    }",
          "attributes": []
